# StyleCart-only settings. Never copy SwiftDrop internal secrets into this file.
STYLECART_DB_PORT=5440
STYLECART_DB_USERNAME=stylecart
STYLECART_DB_PASSWORD=
STYLECART_ADMIN_EMAIL=admin@stylecart.local
STYLECART_ADMIN_PASSWORD=
# Base64 32-byte key for StyleCart's own encrypted integration settings.
STYLECART_SETTINGS_KEY=
SWIFTDROP_GATEWAY_URL=http://localhost:8080
SWIFTDROP_ALLOWED_GATEWAYS=http://localhost:8080,http://127.0.0.1:8080
# Optional initial credentials. They can also be entered in StyleCart admin.
SWIFTDROP_API_KEY=
SWIFTDROP_WEBHOOK_SECRET=
STYLECART_PUBLIC_URL=https://localhost:8090
STYLECART_TLS_ENABLED=true
STYLECART_TLS_PASSWORD=changeit
VITE_STYLECART_BACKEND_URL=https://127.0.0.1:8090
