# Copy to .env and replace every placeholder. .env is ignored by Git; never
# commit real values. Database and RabbitMQ passwords are read by
# docker-compose.yml only when its volumes are first created.

# PostgreSQL server (docker-compose.yml). POSTGRES_USER owns identity_db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=identity_db
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Identity Service (identity_db, as POSTGRES_USER; same password as above)
IDENTITY_SERVICE_PORT=8081
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=
JWT_EXPIRATION_MS=900000
# Refresh token lifetime from sign-in (24 hours; 30 days with "Remember me").
JWT_REFRESH_EXPIRATION_MS=86400000
JWT_REFRESH_REMEMBER_ME_EXPIRATION_MS=2592000000
# Optional one-time first administrator bootstrap. Set email and password
# together for the first Identity Service start, then remove both after login is
# verified. Password length must be 12-72 characters. Never commit real values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=SwiftDrop Administrator
# Google sign-in (optional). Set both values or neither; never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# AWS RDS settings are in the "AWS RDS" section at the end of this file
# (RDS_* names), used only with DB_PROFILE=rds. Do not set
# SPRING_PROFILES_ACTIVE, DB_HOST, DB_NAME or DB_USERNAME in this file.

# Domain services: each has its own database and database user
PARCEL_SERVICE_PORT=8082
PARCEL_DB_PASSWORD=replace-with-parcel-db-password
MERCHANT_SERVICE_PORT=8083
MERCHANT_DB_PASSWORD=replace-with-merchant-db-password
COURIER_SERVICE_PORT=8084
COURIER_DB_PASSWORD=replace-with-courier-db-password
DISPATCH_SERVICE_PORT=8085
DISPATCH_DB_PASSWORD=replace-with-dispatch-db-password
PRICING_SERVICE_PORT=8086
PRICING_DB_PASSWORD=replace-with-pricing-db-password
NOTIFICATION_SERVICE_PORT=8087
NOTIFICATION_DB_PASSWORD=replace-with-notification-db-password
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail: MAIL_USERNAME is the Gmail address, MAIL_PASSWORD an App Password,
# and MAIL_FROM the same address (Gmail rewrites any other sender).
MAIL_FROM=notifications@swiftdrop.com
SMS_ENABLED=true

# Delivery photos (Courier Service, private AWS S3 bucket). Optional: without a
# bucket, couriers can still send status updates, just without a photo. Use an
# IAM user limited to s3:PutObject/GetObject/DeleteObject on <bucket>/proofs/*.
# Share keys privately; never commit them. See the README, "Delivery photos (AWS S3)".
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COURIER_PHOTO_BUCKET=

# RabbitMQ (docker-compose.yml; prepared for future events)
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=replace-with-your-local-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API Gateway
GATEWAY_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
IDENTITY_SERVICE_URL=http://localhost:8081
PARCEL_SERVICE_URL=http://localhost:8082
MERCHANT_SERVICE_URL=http://localhost:8083
COURIER_SERVICE_URL=http://localhost:8084
DISPATCH_SERVICE_URL=http://localhost:8085
PRICING_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
AI_SERVICE_URL=http://localhost:8088

# Frontend
FRONTEND_PORT=3000

# Member 9 integration secrets: share privately with the relevant service owners.
# Same encryption key on every Merchant instance using the same stored settings.
WEBHOOK_ENCRYPTION_KEY=
# Also the service-to-service token (32+ characters) between Identity and
# Notification: account emails (welcome, password reset) and customer email
# lookups for parcel updates. Without it, those emails are not sent and
# "Forgot password" answers 501.
INTERNAL_WEBHOOK_TOKEN=
MERCHANT_ORDER_SERVICE_TOKEN=
SWIFTDROP_WEBHOOKS_CONSUMER_ENABLED=false
SWIFTDROP_WEBHOOKS_WORKER_ENABLED=false
SWIFTDROP_WEBHOOKS_ALLOWED_ORIGINS=https://localhost:9090

# ---------------------------------------------------------------- AWS RDS
# Used only when a service runs with DB_PROFILE=rds, for example
#   DB_PROFILE=rds infrastructure/scripts/run-all.sh
# The *_DB_PASSWORD values above are the local Docker ones; these RDS_* values
# never mix with them. One RDS instance holds seven databases; each service
# connects only to its own one as its own user. Ask the team for the passwords;
# you only need those of the services you run. See the README, "Running the
# services against AWS RDS".
RDS_DB_HOST=swiftdrop-postgres-dev.cbg82w4sqz3y.ap-south-1.rds.amazonaws.com
RDS_DB_PORT=5432

RDS_IDENTITY_DB_NAME=identity_db
RDS_IDENTITY_DB_USERNAME=identity_user
RDS_IDENTITY_DB_PASSWORD=

RDS_PARCEL_DB_NAME=parcel_db
RDS_PARCEL_DB_USERNAME=parcel_user
RDS_PARCEL_DB_PASSWORD=

RDS_MERCHANT_DB_NAME=merchant_db
RDS_MERCHANT_DB_USERNAME=merchant_user
RDS_MERCHANT_DB_PASSWORD=

RDS_COURIER_DB_NAME=courier_db
RDS_COURIER_DB_USERNAME=courier_user
RDS_COURIER_DB_PASSWORD=

RDS_DISPATCH_DB_NAME=dispatch_db
RDS_DISPATCH_DB_USERNAME=dispatch_user
RDS_DISPATCH_DB_PASSWORD=

RDS_PRICING_DB_NAME=pricing_db
RDS_PRICING_DB_USERNAME=pricing_user
RDS_PRICING_DB_PASSWORD=

RDS_NOTIFICATION_DB_NAME=notification_db
RDS_NOTIFICATION_DB_USERNAME=notification_user
RDS_NOTIFICATION_DB_PASSWORD=
