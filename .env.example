# PostgreSQL
POSTGRES_DB=identity_db
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=replace-with-your-local-database-password
DB_PASSWORD=replace-with-your-local-database-password

# Identity Service
IDENTITY_SERVICE_PORT=8081
JWT_SECRET=
JWT_EXPIRATION_MS=900000
# Google sign-in (optional; leave GOOGLE_CLIENT_ID empty to disable it).
# Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# API Gateway
GATEWAY_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:8081
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
