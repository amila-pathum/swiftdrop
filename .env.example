# Copy to .env and replace every placeholder. .env is ignored by Git; never
# commit real values. Database and RabbitMQ passwords are read by
# docker-compose.yml only when its volumes are first created.

# PostgreSQL server (docker-compose.yml). POSTGRES_USER owns identity_db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=identity_db
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Identity Service (identity_db, as POSTGRES_USER; same password as above)
IDENTITY_SERVICE_PORT=8081
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=
JWT_EXPIRATION_MS=900000
# Google sign-in (optional). Set both values or neither; never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Identity Service against the shared AWS RDS database (opt-in profile "rds";
# see the README, "Running the Identity Service against AWS RDS"). Unused
# unless SPRING_PROFILES_ACTIVE=rds. Do not set SPRING_PROFILES_ACTIVE here:
# pass it per run. The RDS password is also DB_PASSWORD; supply it at run time
# (the README shows how) so the Docker value above stays untouched.
DB_HOST=replace-with-the-rds-endpoint
DB_PORT=5432
DB_NAME=swiftdrop_dev
DB_USERNAME=replace-with-the-rds-username

# Domain services: each has its own database and database user
PARCEL_SERVICE_PORT=8082
PARCEL_DB_PASSWORD=replace-with-parcel-db-password
MERCHANT_SERVICE_PORT=8083
MERCHANT_DB_PASSWORD=replace-with-merchant-db-password
COURIER_SERVICE_PORT=8084
COURIER_DB_PASSWORD=replace-with-courier-db-password
DISPATCH_SERVICE_PORT=8085
DISPATCH_DB_PASSWORD=replace-with-dispatch-db-password
PRICING_SERVICE_PORT=8086
PRICING_DB_PASSWORD=replace-with-pricing-db-password
NOTIFICATION_SERVICE_PORT=8087
NOTIFICATION_DB_PASSWORD=replace-with-notification-db-password

# RabbitMQ (docker-compose.yml; prepared for future events)
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=replace-with-your-local-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API Gateway
GATEWAY_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
IDENTITY_SERVICE_URL=http://localhost:8081
PARCEL_SERVICE_URL=http://localhost:8082
MERCHANT_SERVICE_URL=http://localhost:8083
COURIER_SERVICE_URL=http://localhost:8084
DISPATCH_SERVICE_URL=http://localhost:8085
PRICING_SERVICE_URL=http://localhost:8086

# Frontend
FRONTEND_PORT=3000
