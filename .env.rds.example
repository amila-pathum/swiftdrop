# AWS RDS settings for running services with the "rds" Spring profile.
#
#   cp .env.rds.example .env.rds      # then fill in the seven passwords
#   DB_PROFILE=rds infrastructure/scripts/run-service.sh identity-service
#
# .env.rds is ignored by Git. Never commit it and never put a real password
# in this example file. Ask the team for the passwords.
#
# One RDS instance (one endpoint) holds seven independent databases. Each
# service connects only to its own database as its own login user, so every
# service has its own NAME / USERNAME / PASSWORD below. run-service.sh copies
# the selected service's values into DB_NAME / DB_USERNAME / DB_PASSWORD,
# which is what application-rds.properties reads.
#
# Local Docker development does not use this file; it keeps using .env.

# Shared by all services: the RDS endpoint (not a secret) and port.
DB_HOST=swiftdrop-postgres-dev.cbg82w4sqz3y.ap-south-1.rds.amazonaws.com
DB_PORT=5432

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USERNAME=identity_user
IDENTITY_DB_PASSWORD=

PARCEL_DB_NAME=parcel_db
PARCEL_DB_USERNAME=parcel_user
PARCEL_DB_PASSWORD=

MERCHANT_DB_NAME=merchant_db
MERCHANT_DB_USERNAME=merchant_user
MERCHANT_DB_PASSWORD=

COURIER_DB_NAME=courier_db
COURIER_DB_USERNAME=courier_user
COURIER_DB_PASSWORD=

DISPATCH_DB_NAME=dispatch_db
DISPATCH_DB_USERNAME=dispatch_user
DISPATCH_DB_PASSWORD=

PRICING_DB_NAME=pricing_db
PRICING_DB_USERNAME=pricing_user
PRICING_DB_PASSWORD=

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=
