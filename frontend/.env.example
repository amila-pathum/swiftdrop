# API Gateway base URL used by the browser. Copy to .env.local to override.
# Only VITE_-prefixed variables are exposed to the browser; never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
# Show "Continue with Google". Requires GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET on the
# Identity Service; the Google client ID and secret never belong in the frontend.
VITE_GOOGLE_LOGIN_ENABLED=false
